{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "components.tirup.in" }],
      "destination": "/components/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.components.tirup.in" }],
      "destination": "/components/:path*"
    }
  ]
}
